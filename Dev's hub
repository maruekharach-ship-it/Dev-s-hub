-- 2. TPWalk
---------------------------------------------------------
local TPWalkBtn = createButton("TPWalk : OFF")
local SpeedInput = createInput("ความเร็ว TPWalk (เช่น 2.5)", "2.5")
local tpWalkEnabled = false
local tpWalkSpeed = 2.5
local tpWalkConn = nil

SpeedInput.FocusLost:Connect(function()
    tpWalkSpeed = tonumber(SpeedInput.Text) or tpWalkSpeed
    SpeedInput.Text = tostring(tpWalkSpeed)
end)

TPWalkBtn.MouseButton1Click:Connect(function()
    tpWalkEnabled = not tpWalkEnabled
    TPWalkBtn.Text = tpWalkEnabled and "TPWalk : ON" or "TPWalk : OFF"
    TPWalkBtn.BackgroundColor3 = tpWalkEnabled and Color3.fromRGB(40, 180, 40) or Color3.fromRGB(180, 40, 40)
    
    if tpWalkEnabled then
        tpWalkConn = RunService.Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
                local hum = char.Humanoid
                local hrp = char.HumanoidRootPart
                if hum.MoveDirection.Magnitude > 0 then
                    hrp.CFrame = hrp.CFrame + (hum.MoveDirection * tpWalkSpeed)
                end
            end
        end)
    elseif tpWalkConn then
        tpWalkConn:Disconnect()
        tpWalkConn = nil
    end
end)

