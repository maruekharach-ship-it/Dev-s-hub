---------------------------------------------------------
local AimbotBtn = createButton("Aimbot : OFF")
local TargetPartBtn = createButton("เป้าหมาย : Head")
local FOVInput = createInput("ขนาดวง FOV (เช่น 150)", "150")

local aimbotEnabled = false
local targetPart = "Head" -- "Head" หรือ "HumanoidRootPart"
local fovRadius = 150

-- สร้างวงกลม FOV
local FOVCircle = Drawing.new("Circle")
