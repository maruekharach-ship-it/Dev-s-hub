-- 1. หยุดเวลา (Time Stop)
---------------------------------------------------------
local TimeStopBtn = createButton("หยุดเวลา : OFF")
local isTimeStopped = false

TimeStopBtn.MouseButton1Click:Connect(function()
    isTimeStopped = not isTimeStopped
    TimeStopBtn.Text = isTimeStopped and "หยุดเวลา : ON" or "หยุดเวลา : OFF"
    TimeStopBtn.BackgroundColor3 = isTimeStopped and Color3.fromRGB(40, 180, 40) or Color3.fromRGB(180, 40, 40)
    
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Humanoid") and obj.Parent ~= LocalPlayer.Character then
            local root = obj.Parent:FindFirstChild("HumanoidRootPart")
            if root then root.Anchored = isTimeStopped end
        end
    end
end)

